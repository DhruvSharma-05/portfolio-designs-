# ==================================================================
# Copy to `.env` and fill in. On Vercel, set the same values in
# Project Settings → Environment Variables.
#
# The site is a pure static build — none of this is required to run
# locally. Without it the site renders with placeholder photos, and
# the contact form falls back to a plain mailto link.
# ==================================================================

# --- Contentful: portfolio photos (build-time sync) ----------------
# Work / Gallery / Portrait photos are pulled from Contentful at build
# time by scripts/sync-contentful.mjs and baked into the deploy. The
# live site never calls Contentful at runtime. Content Delivery API
# only (read-only, published entries).
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# --- Contact form (Formspree) --------------------------------------
# The enquiry form on the contact section POSTs to Formspree, which
# emails the submission to Viraj. This is a *client-side* variable, so
# it MUST be prefixed VITE_ to be exposed to the browser build.
#
# Setup (one time, ~2 minutes):
#   1. Sign up at https://formspree.io with Viraj's email.
#   2. Create a new form; its endpoint looks like
#      https://formspree.io/f/abcdwxyz  →  the id is the "abcdwxyz" part.
#   3. Put just that id below (and in Vercel env vars), then redeploy.
# Until this is set, the contact section shows the mailto link instead.
VITE_FORMSPREE_ID=

# --- Vercel deploy hook (optional) ---------------------------------
# Vercel → Settings → Git → Deploy Hooks → create one, paste the URL.
# Wire a Contentful "publish" webhook to it so new photos go live
# automatically (see CLAUDE.md / PRODUCTION.md "Auto-publishing").
# Treat as a secret. Leave blank if you don't use it.
VERCEL_DEPLOY_HOOK_URL=
